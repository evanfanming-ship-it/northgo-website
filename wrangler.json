{
  "name": "northgo-website",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".cloudflare-dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "northgo-enquiries",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "27111801", "simple": { "limit": 8, "period": 60 } },
    { "name": "ENQUIRY_LIMIT", "namespace_id": "27111802", "simple": { "limit": 25, "period": 60 } }
  ]
}
